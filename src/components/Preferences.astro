<div class="preferences" data-preferences hidden>
  <div class="theme-picker">
    <button
      type="button"
      class="preference-button theme-toggle"
      aria-label="切换主题"
      data-i18n-aria="theme"
      aria-expanded="false"
      aria-controls="theme-options"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <g data-theme-icon="system">
          <rect x="3" y="4" width="18" height="13" rx="2" />
          <path d="M8 21h8m-4-4v4" />
        </g>
        <g data-theme-icon="light" display="none">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5" />
        </g>
        <g data-theme-icon="dark" display="none">
          <path d="M20.5 13.3A8.8 8.8 0 0 1 10.7 3.5a8.8 8.8 0 1 0 9.8 9.8Z" />
        </g>
      </svg>
    </button>
    <div
      class="theme-options"
      id="theme-options"
      role="group"
      aria-label="切换主题"
      data-i18n-aria="theme"
      hidden
    >
      <button type="button" data-theme-choice="system" aria-pressed="true" data-i18n="themeSystem">
        跟随系统
      </button>
      <button type="button" data-theme-choice="light" aria-pressed="false" data-i18n="themeLight">
        浅色
      </button>
      <button type="button" data-theme-choice="dark" aria-pressed="false" data-i18n="themeDark">
        深色
      </button>
    </div>
  </div>
  <button
    type="button"
    class="preference-button language-toggle"
    aria-label="Switch to English"
    lang="en"
  >
    EN
  </button>
</div>
